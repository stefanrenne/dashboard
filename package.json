{
  "name": "dashboard",
  "version": "0.23.0",
  "private": true,
  "description": "A self-hosted start page for your homelab, configured in YAML, with widgets anyone can publish",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js --config config.example --port 3000",
    "test": "node --test --test-force-exit \"tests/**/*.test.mjs\"",
    "new-widget": "node scripts/new-widget.mjs",
    "i18n": "node scripts/i18n.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanrenne/dashboard.git"
  }
}
