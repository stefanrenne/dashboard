{
  "kind": "IngressList",
  "items": [
    { "metadata": { "name": "grafana", "namespace": "monitoring",
        "annotations": { "getdashboard.dev/enabled": "true", "getdashboard.dev/name": "Grafana", "getdashboard.dev/group": "Monitoring", "getdashboard.dev/icon": "grafana.svg" } },
      "spec": { "tls": [{ "hosts": ["grafana.example.com"] }], "rules": [{ "host": "grafana.example.com", "http": { "paths": [{ "path": "/" }] } }] } },
    { "metadata": { "name": "wiki", "namespace": "apps", "annotations": { "getdashboard.dev/enabled": "true" } },
      "spec": { "rules": [{ "host": "wiki.lan", "http": { "paths": [{ "path": "/docs" }] } }] } },
    { "metadata": { "name": "hidden", "namespace": "apps", "annotations": {} },
      "spec": { "rules": [{ "host": "hidden.lan" }] } }
  ]
}
